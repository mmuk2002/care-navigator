# Required for voice and analysis
GEMINI_API_KEY=

# Gemini Live model (must support bidiGenerateContent)
GEMINI_LIVE_MODEL=gemini-3.8-live

# Primary extractor: one OpenAI-compatible call per turn. Used first when set.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Gemini extraction model, used if DeepSeek is unset or unavailable.
GEMINI_TEXT_MODEL=gemini-2.5-flash

# Comma-separated fallbacks tried in order if a model is rate-limited or down.
GEMINI_TEXT_FALLBACKS=gemini-3.1-flash-lite,gemini-2.5-flash-lite,gemini-3.8-flash

# How long to wait for extraction before falling back to rules
ANALYSIS_TIMEOUT_MS=12000

# Set in production to serve the built client instead of the Vite dev server
NODE_ENV=development

# Optional: use Postgres instead of the embedded PGlite database
# DATABASE_URL=postgres://user:password@host:5432/harbor
# PGSSL=require

# Optional: where the embedded database stores its files
# DATA_DIR=./data
